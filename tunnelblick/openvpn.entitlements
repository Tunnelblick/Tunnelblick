<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allow the hardened-runtime openvpn binary to load PKCS#11 provider libraries
	     (e.g. OpenSC, YubiKey libykcs11, JaCarta, SafeNet) which are signed by other developers. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
